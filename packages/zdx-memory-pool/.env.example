# AgentCore team-shared continuity database
ZDX_MEMORY_AGENTCORE_BACKEND=postgres
ZDX_MEMORY_AGENTCORE_DATABASE_URL=postgresql://zdx_agentcore_memory:replace-me@127.0.0.1:5432/zdx_platform
ZDX_MEMORY_AGENTCORE_ROLE=zdx_agentcore_memory
ZDX_MEMORY_AGENTCORE_SCHEMA=zdx_memory_agentcore
ZDX_MEMORY_AGENTCORE_POOL_MAX=5

# Data Synthesis gets its own database identity/schema
ZDX_MEMORY_DATA_SYNTHESIS_BACKEND=postgres
ZDX_MEMORY_DATA_SYNTHESIS_DATABASE_URL=postgresql://zdx_synthesis_memory:replace-me@127.0.0.1:5432/zdx_platform
ZDX_MEMORY_DATA_SYNTHESIS_ROLE=zdx_synthesis_memory
ZDX_MEMORY_DATA_SYNTHESIS_SCHEMA=zdx_memory_synthesis
ZDX_MEMORY_DATA_SYNTHESIS_POOL_MAX=4

# Book Studio gets its own database identity/schema
ZDX_MEMORY_BOOK_STUDIO_BACKEND=postgres
ZDX_MEMORY_BOOK_STUDIO_DATABASE_URL=postgresql://zdx_book_memory:replace-me@127.0.0.1:5432/zdx_platform
ZDX_MEMORY_BOOK_STUDIO_ROLE=zdx_book_memory
ZDX_MEMORY_BOOK_STUDIO_SCHEMA=zdx_memory_book_studio
ZDX_MEMORY_BOOK_STUDIO_POOL_MAX=3

# Individual agents default to SQLite; override per agent as needed.
ZDX_MEMORY_AGENT_BACKEND=sqlite
ZDX_MEMORY_AGENT_SQLITE_PATH=/var/lib/zerodrivex/memory/agents/default.sqlite
ZDX_MEMORY_AGENT_SCHEMA=zdx_memory
ZDX_MEMORY_AGENT_POOL_MAX=1

# Example dedicated agent override:
# ZDX_MEMORY_AGENT_RESEARCHER_BACKEND=postgres
# ZDX_MEMORY_AGENT_RESEARCHER_DATABASE_URL=postgresql://zdx_researcher:replace-me@127.0.0.1:5432/zdx_platform
# ZDX_MEMORY_AGENT_RESEARCHER_ROLE=zdx_researcher
# ZDX_MEMORY_AGENT_RESEARCHER_SCHEMA=zdx_memory_researcher
# ZDX_MEMORY_AGENT_RESEARCHER_POOL_MAX=2

# Optional per-platform CA bundle. TLS verification remains mandatory.
# ZDX_MEMORY_AGENTCORE_SSL_CA_FILE=/etc/ssl/certs/aws-rds-us-east-1.pem
# ZDX_MEMORY_DATA_SYNTHESIS_SSL_CA_FILE=/etc/ssl/certs/aws-rds-us-east-1.pem
# ZDX_MEMORY_BOOK_STUDIO_SSL_CA_FILE=/etc/ssl/certs/aws-rds-us-east-1.pem
# ZDX_MEMORY_AGENT_SSL_CA_FILE=/etc/ssl/certs/aws-rds-us-east-1.pem
