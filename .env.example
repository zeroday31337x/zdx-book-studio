BOOK_STUDIO_PORT=3210
BOOK_STUDIO_HOST=127.0.0.1
BOOK_STUDIO_DATA=/home/zdxadmin/zdx-book-studio/data/books.json
BOOK_STUDIO_AUTH_DATA=/home/zdxadmin/zdx-book-studio/data/auth.json
BOOK_STUDIO_ADMIN_EMAIL=admin@example.com
BOOK_STUDIO_ADMIN_PASSWORD=replace-with-strong-temporary-password
BOOK_STUDIO_SESSION_HOURS=12
BOOK_STUDIO_COOKIE_SECURE=1
BOOK_COGNITO_CLIENT_ID=5bm33hgo98vvfs0jv26vmo5r4u
# Use a dedicated random secret of at least 32 bytes; JWT_SECRET remains a fallback for existing deployments.
ZDX_OIDC_SECRET=replace-with-at-least-32-random-bytes
ZDX_AGENT_CORE_PATH=/home/zdxadmin/zdx-agent-team
ZDX_AGENT_ENV=/home/zdxadmin/zdx-agent-team/.env
BOOK_OLLAMA_BASE_URL=http://127.0.0.1:11436
BOOK_OLLAMA_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# Product options below are FALLBACK DEFAULTS. Their primary home is the
# database: Admin dashboard -> Platform settings (DB setting wins over env,
# changes apply without a restart). Env remains authoritative only for
# bootstrap wiring and secrets (paths, listen address, Cognito, API keys).
# Optional: run the review gate on a different model than the writer's.
# Studio only talks to the ZDX inference pool, and the pool takes a model,
# not a provider designation. Unset: the reviewer uses the writer's model.
BOOK_REVIEWER_MODEL=
# Optional: inference rate card as JSON, keys "provider:model", "model",
# "provider:*" or "*", values { "inputPer1M": 0, "outputPer1M": 0 } in USD.
# Self-hosted pool models default to $0/token; tokens + latency are metered
# regardless and shown in the admin dashboard.
BOOK_STUDIO_MODEL_RATES=
# How often the legacy books.json recovery mirror is refreshed (ms).
# SQLite is the store of record; the mirror also flushes on shutdown.
BOOK_STUDIO_LEGACY_MIRROR_MS=900000

